{
  "name": "@vectorfyco/up-bank-sdk",
  "version": "3.0.0",
  "description": "The Up Bank API TypeScript wrapper",
  "packageManager": "pnpm@10.26.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./zod": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./generated": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    }
  },
  "scripts": {
    "generate": "tsx ./scripts/generate.mts",
    "build": "tsx ./scripts/build.mts",
    "dev": "tsx ./scripts/dev.mts",
    "lint": "eslint .",
    "format": "prettier -w .github/**/*.{yml,yaml} package.json README.md src/**/*.ts scripts/**/*.mts scripts/**/*.hbs",
    "format:check": "prettier --check .github/**/*.{yml,yaml} package.json README.md src/**/*.ts scripts/**/*.mts scripts/**/*.hbs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsx ./scripts/smoke.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "repository": "https://github.com/vectorfy-co/up-bank-sdk",
  "keywords": [
    "up",
    "banking",
    "upbank"
  ],
  "author": "Vectorfy Co.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vectorfy-co/up-bank-sdk/issues"
  },
  "homepage": "https://github.com/vectorfy-co/up-bank-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/query-core": "^5.102.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openapi-zod-client": "^1.18.3",
    "@tanstack/react-query": "^5.102.8",
    "tsx": "^4.23.12",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^10.5.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
